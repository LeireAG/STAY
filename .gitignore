.DS_Store
__pycache__/

# Data and results are not tracked. Each data folder keeps its README.md
# so the layout (and where to download each part) stays browsable on git.
/data/**
!/data/**/
!/data/**/README.md
# detachment annotation (Figure 2): light images to annotate and the manual annotations
!/data/analysis/*/detachment_annotation_input/*.jpg
!/data/analysis/*/detachment_annotation/*.json
/results/**
!/results/README.md

/internal/
